{% extends "Master/MenuBgTemplate.html.twig" %}

{% block body %}
<div class="container-fluid mt-4 mb-5">
  <div class="row justify-content-center">
    <div class="col-lg-9">

      {% if fsc.volverA %}
      <a href="{{ asset(fsc.volverA) }}" class="btn btn-outline-secondary mb-3">
        <i class="fas fa-arrow-left me-1"></i>{{ trans('back') }}
      </a>
      {% endif %}

      {% if fsc.mensaje %}
      <div class="alert alert-{{ fsc.mensajeTipo }}">
        {{ fsc.mensaje }}
      </div>
      {% endif %}

      {# Resultado: enlace listo para copiar #}
      {% if fsc.firmaCreada %}
      <div class="card shadow mb-3">
        <div class="card-body">
          <h3 class="h4 mb-3">
            <i class="fas fa-check-circle text-success me-2"></i>{{ fsc.firmaCreada.getTitulo() }}
          </h3>
          <label class="mb-0">{{ trans('firmadoc-send-sign-link') }}</label>
          {# Mismos botones que en la pestaña de un documento: copiar, abrir,
             WhatsApp y reenviar por email. #}
          <div class="input-group mb-2">
            <input type="text" class="form-control" id="enlace-firma" readonly value="{{ fsc.linkFirma }}">
            <button class="btn btn-outline-secondary" type="button" onclick="copiarEnlace()"
                    title="{{ trans('copy') }}">
              <i class="fas fa-copy"></i>
            </button>
            <a href="{{ fsc.linkFirma }}" target="_blank" rel="noopener"
               class="btn btn-outline-primary" title="{{ trans('firmadoc-open-new-tab') }}">
              <i class="fas fa-external-link-alt"></i>
            </a>
            {% if fsc.linkWhatsApp %}
            <a href="{{ fsc.linkWhatsApp }}" target="_blank" rel="noopener"
               class="btn btn-success" title="{{ trans('firmadoc-send-via-whatsapp') }}">
              <i class="fab fa-whatsapp"></i>
            </a>
            {% endif %}
            <form method="post" style="display:contents">
              {{ formToken() | raw }}
              <input type="hidden" name="action" value="reenviar">
              <input type="hidden" name="firmadoc_id" value="{{ fsc.firmaCreada.id }}">
              <button type="submit" class="btn btn-primary"
                      title="{{ trans('firmadoc-resend-email') }}">
                <i class="fas fa-envelope"></i>
              </button>
            </form>
          </div>
          {% if not fsc.linkWhatsApp %}
          <p class="small text-muted mb-2">
            <i class="fab fa-whatsapp me-1"></i>{{ trans('firmadoc-no-phone-no-whatsapp') }}
          </p>
          {% endif %}
          <p class="small text-muted mb-0">
            {{ trans('firmadoc-verification-code') }}: <code>{{ fsc.firmaCreada.codigo_verificacion }}</code>
          </p>
        </div>
      </div>
      {% endif %}

      {% include 'FirmaDocFormulario.html.twig' with {
        'terceroFijo': false,
        'clientes': fsc.clientes,
        'proveedores': fsc.proveedores,
        'codclienteSel': fsc.codclienteSel,
        'codproveedorSel': fsc.codproveedorSel,
        'maxSubida': fsc.maxSubida,
        'volver': fsc.volverA
      } only %}

    </div>
  </div>
</div>

<script>
function copiarEnlace() {
    var campo = document.getElementById('enlace-firma');
    campo.select();
    campo.setSelectionRange(0, 99999);
    document.execCommand('copy');
}
</script>
{% endblock %}
