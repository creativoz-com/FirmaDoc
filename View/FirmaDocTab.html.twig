 * Estructura y clases calcadas de las vistas del núcleo —card shadow, card-body,
 * títulos h3.h4 y badges de Bootstrap—: la pestaña tiene que parecer una más del
 * ERP, no una pantalla traída de otro sitio.
#}
{% set config = view.firmadocConfig %}
{% set baseUrl = view.firmadocBaseUrl %}
{% set firmas = view.cursor %}
{% set waLinks = view.firmadocWaLinks %}
{% set emailPrellenado = view.firmadocEmail %}
{% set telefonoPrellenado = view.firmadocTelefono %}

{# Buscar estados activos — orden importante: primero firmado, luego pendiente, luego anulado #}
{% set firmaActiva = null %}
{% set firmaFirmada = null %}
{% set firmaAnulada = null %}
{% for f in firmas %}
  {% if f.estado == 'pendiente' and firmaActiva is null %}{% set firmaActiva = f %}{% endif %}
  {% if f.estado == 'firmado' and firmaFirmada is null %}{% set firmaFirmada = f %}{% endif %}
  {% if f.estado == 'anulado_mod' and firmaAnulada is null %}{% set firmaAnulada = f %}{% endif %}
{% endfor %}

<div class="container-fluid pt-3">

{# ── DOCUMENTO FIRMADO ─── #}
{% if firmas|length > 0 and firmas[0].estado == 'firmado' %}
<div class="alert alert-success d-flex align-items-start">
  <i class="fas fa-check-circle fa-2x me-3 mt-1"></i>
  <div>
    <strong>{{ trans('firmadoc-tab-signed-doc') }}</strong>
    {% if firmaFirmada.modo_multifirma and firmaFirmada.modo_multifirma != 'unico' %}
      {# Multi-firmante: mostrar suma de veces visto, no datos individuales #}
      <br>
      {% if firmaFirmada.modo_multifirma == 'paralelo' %}
        <i class="fas fa-users me-1"></i>{{ trans('firmadoc-tab-signed-all-parallel') }}
      {% else %}
        <i class="fas fa-list-ol me-1"></i>{{ trans('firmadoc-tab-signed-all-sequential') }}
      {% endif %}
      {% if firmaFirmada.firmantes is defined and firmaFirmada.firmantes|length > 0 %}
        {% set totalVisto = 0 %}
        {% for f in firmaFirmada.firmantes %}{% set totalVisto = totalVisto + (f.veces_visto ?? 0) %}{% endfor %}
        {% if totalVisto > 0 %}
          &nbsp;·&nbsp; <i class="fas fa-eye me-1"></i>{{ trans('firmadoc-tab-views-total', {'%count%': totalVisto}) }}
        {% endif %}
      {% endif %}
      <br><small>{{ trans('firmadoc-tab-see-history-detail') }}</small>
    {% else %}
      {# Modo único: mostrar datos completos #}
      <br>{{ trans('firmadoc-signed-on') }} <strong>{{ firmaFirmada.fecha_firma }}</strong>
      {{ trans('firmadoc-tab-by') }} <strong>{{ firmaFirmada.firma_nombre }}</strong>
      {% if firmaFirmada.firma_nif %} &nbsp;·&nbsp; NIF: {{ firmaFirmada.firma_nif }}{% endif %}
      {% if firmaFirmada.modo_firma == 'certificado' %}
        &nbsp;·&nbsp; <span class="badge bg-success"><i class="fas fa-id-card me-1"></i>{{ trans('firmadoc-digital-certificate') }}</span>
      {% endif %}
      {% if firmaFirmada.ip_cliente %} &nbsp;·&nbsp; IP: {{ firmaFirmada.ip_cliente }}{% endif %}
      {% if firmaFirmada.observaciones_firmante %}
      <br><span class="badge bg-light text-dark border mt-1">
        <i class="fas fa-comment-alt me-1"></i>
        <em>{{ firmaFirmada.observaciones_firmante }}</em>
      </span>
      {% endif %}
    {% endif %}
    <br><small>{{ trans('firmadoc-tab-valid-while-unmodified') }}</small>
  </div>
</div>
{% endif %}

{# ── FIRMA ANULADA POR MODIFICACIÓN (solo si el último registro es anulado) ─── #}
{% if firmas|length > 0 and firmas[0].estado == 'anulado_mod' %}
<div class="alert alert-warning">
  <i class="fas fa-exclamation-triangle me-2"></i>
  <strong>{{ trans('firmadoc-tab-signature-voided') }}</strong> {{ trans('firmadoc-tab-voided-explain') }}
</div>
{% endif %}

{# ── ENLACE PENDIENTE (solo si NO hay firma válida) ─── #}
{% if firmaActiva and not firmaFirmada %}
<div class="card shadow mb-3">
  <div class="card-body">
    <h3 class="h4 mb-3">
      <i class="fas fa-clock fa-fw me-2"></i>{{ trans('firmadoc-tab-pending-signature') }}
      <small class="text-muted">· {{ trans('firmadoc-tab-valid-until', {'%date%': firmaActiva.fecha_expiracion}) }}</small>
      {% if firmaActiva.modo_multifirma and firmaActiva.modo_multifirma != 'unico' %}
        <span class="badge bg-secondary">
          {% if firmaActiva.modo_multifirma == 'paralelo' %}
            <i class="fas fa-users me-1"></i>{{ trans('firmadoc-tab-parallel-n', {'%count%': firmaActiva.firmantes|length}) }}
          {% else %}
            <i class="fas fa-list-ol me-1"></i>{{ trans('firmadoc-tab-sequential-n', {'%count%': firmaActiva.firmantes|length}) }}
          {% endif %}
        </span>
      {% endif %}
    </h3>

    {# MODO INDIVIDUAL: enlace único + botones Copiar, Abrir, WhatsApp, Email #}
    {% if firmaActiva.modo_multifirma == 'unico' or firmaActiva.firmantes|length <= 1 %}
    <div class="mb-3">
      <label class="mb-0">{{ trans('firmadoc-send-sign-link') }}</label>
      <div class="input-group">
        <input type="text" class="form-control" id="firmadocLinkInput"
               value="{{ baseUrl }}/FirmaDocPublic?token={{ firmaActiva.token }}" readonly>
        <button class="btn btn-outline-secondary" type="button" onclick="firmadocCopiar()" title="{{ trans('copy') }}">
          <i class="fas fa-copy"></i>
        </button>
        <a href="{{ baseUrl }}/FirmaDocPublic?token={{ firmaActiva.token }}"
           target="_blank" rel="noopener" class="btn btn-outline-primary" title="{{ trans('firmadoc-open-new-tab') }}">
          <i class="fas fa-external-link-alt"></i>
        </a>
        {% if waLinks[firmaActiva.id] is defined %}
        <a href="{{ waLinks[firmaActiva.id] }}" target="_blank" rel="noopener"
           class="btn btn-success" title="{{ trans('firmadoc-send-via-whatsapp') }}">
          <i class="fab fa-whatsapp"></i>
        </a>
        {% endif %}
        <form method="post" action="{{ fsc.url() }}" style="display:contents">
          {{ formToken() | raw }}
          <input type="hidden" name="activetab" value="FirmaDocTab">
          <input type="hidden" name="code" value="{{ fsc.getModel().primaryColumnValue() }}">
          <input type="hidden" name="action" value="firmadoc-email">
          <input type="hidden" name="firmadoc_id" value="{{ firmaActiva.id }}">
          <button type="submit" class="btn btn-primary" title="{{ trans('firmadoc-resend-email') }}">
            <i class="fas fa-envelope"></i>
          </button>
        </form>
      </div>
    </div>

    {# MODO MULTI-FIRMANTE: tabla de firmantes con estado y botones individuales #}
    {% else %}
    <div class="table-responsive mb-3">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th style="width:24px">#</th>
            <th>{{ trans('name') }}</th>
            <th>{{ trans('email') }}</th>
            <th>{{ trans('status') }}</th>
            <th>{{ trans('firmadoc-tab-link-actions') }}</th>
          </tr>
        </thead>
        <tbody>
          {% for firmante in firmaActiva.firmantes %}
          <tr>
            <td class="text-center fw-bold">{{ firmante.orden }}</td>
            <td style="white-space:nowrap">{{ firmante.nombre ?: '—' }}</td>
            <td style="white-space:nowrap">{{ firmante.email }}</td>
            <td style="white-space:nowrap">
              {% if firmante.estado == 'firmado' %}
                <span class="badge bg-success">{{ trans('firmadoc-badge-signed') }}</span>
              {% elseif firmante.estado == 'esperando' %}
                <span class="badge bg-secondary">{{ trans('firmadoc-tab-waiting') }}</span>
              {% else %}
                <span class="badge bg-warning text-dark">{{ trans('firmadoc-badge-pending') }}</span>
              {% endif %}
            </td>
            <td>
              {% if firmante.estado == 'pendiente' %}
              <div class="input-group input-group-sm flex-nowrap">
                <input type="text" class="form-control"
                       value="{{ baseUrl }}/FirmaDocPublic?token={{ firmante.token }}"
                       id="fd-link-{{ firmante.id }}" readonly style="min-width:80px">
                <button class="btn btn-outline-secondary" type="button"
                        onclick="navigator.clipboard.writeText(document.getElementById('fd-link-{{ firmante.id }}').value)"
                        title="{{ trans('copy') }}"><i class="fas fa-copy"></i></button>
                <a href="{{ baseUrl }}/FirmaDocPublic?token={{ firmante.token }}"
                   target="_blank" rel="noopener" class="btn btn-outline-primary"
                   title="{{ trans('open') }}"><i class="fas fa-external-link-alt"></i></a>
                {% set waKeyFirmante = 'firmante_' ~ firmante.id %}
                {% if waLinks[waKeyFirmante] is defined %}
                <a href="{{ waLinks[waKeyFirmante] }}"
                   target="_blank" rel="noopener" class="btn btn-success"
                   title="{{ trans('firmadoc-tab-whatsapp-to', {'%name%': firmante.nombre}) }}">
                  <i class="fab fa-whatsapp"></i></a>
                {% endif %}
                <form method="post" action="{{ fsc.url() }}" style="display:contents">
                  {{ formToken() | raw }}
                  <input type="hidden" name="activetab" value="FirmaDocTab">
                  <input type="hidden" name="code" value="{{ fsc.getModel().primaryColumnValue() }}">
                  <input type="hidden" name="action" value="firmadoc-email-firmante">
                  <input type="hidden" name="firmante_id" value="{{ firmante.id }}">
                  <input type="hidden" name="firmadoc_id" value="{{ firmaActiva.id }}">
                  <button type="submit" class="btn btn-primary"
                          title="{{ trans('firmadoc-tab-resend-to', {'%name%': firmante.nombre}) }}">
                    <i class="fas fa-envelope"></i>
                  </button>
                </form>
              </div>
              {% elseif firmante.estado == 'firmado' %}
                <span class="text-success"><i class="fas fa-check-circle"></i> {{ firmante.fecha_firma }}</span>
              {% else %}
                <span class="text-muted">—</span>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    {# Cancelar — siempre disponible #}
    <form method="post" action="{{ fsc.url() }}"
          onsubmit="return confirm(FD_CONFIRMAR_CANCELAR)">
      {{ formToken() | raw }}
      <input type="hidden" name="activetab" value="FirmaDocTab">
      <input type="hidden" name="code" value="{{ fsc.getModel().primaryColumnValue() }}">
      <input type="hidden" name="action" value="firmadoc-cancelar">
      <input type="hidden" name="firmadoc_id" value="{{ firmaActiva.id }}">
      <button type="submit" class="btn btn-outline-danger">
        <i class="fas fa-ban me-1"></i> {{ firmaActiva.firmantes|length > 1 ? trans('firmadoc-tab-cancel-links') : trans('firmadoc-tab-cancel-link') }}
      </button>
    </form>

  </div>
</div>

{% elseif firmas|length == 0 or firmas[0].estado in ['anulado_mod', 'cancelado', 'expirado'] %}
{# ── FORMULARIO GENERAR NUEVO ENLACE ─── #}
<div class="card shadow mb-3">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
      <h3 class="h4 mb-0"><i class="fas fa-signature fa-fw me-2"></i>{{ trans('firmadoc-tab-request-signature') }}</h3>
      {# Selector de modo #}
      <div class="btn-group" role="group">
        <button type="button" class="btn btn-outline-secondary active" id="btn-modo-unico"
                onclick="firmadocSetModo('unico')" title="{{ trans('firmadoc-tab-one-signer-only') }}">
          <i class="fas fa-user"></i> {{ trans('firmadoc-tab-mode-single') }}
        </button>
        <button type="button" class="btn btn-outline-secondary" id="btn-modo-paralelo"
                onclick="firmadocSetModo('paralelo')" title="{{ trans('firmadoc-tab-several-parallel') }}">
          <i class="fas fa-users"></i> {{ trans('firmadoc-mode-parallel') }}
        </button>
        <button type="button" class="btn btn-outline-secondary" id="btn-modo-secuencial"
                onclick="firmadocSetModo('secuencial')" title="{{ trans('firmadoc-tab-several-sequential') }}">
          <i class="fas fa-list-ol"></i> {{ trans('firmadoc-mode-sequential') }}
        </button>
      </div>
    </div>

    <form method="post" action="{{ fsc.url() }}" id="form-firmadoc-generar">
      {{ formToken() | raw }}
      <input type="hidden" name="activetab" value="FirmaDocTab">
      <input type="hidden" name="code" value="{{ fsc.getModel().primaryColumnValue() }}">
      <input type="hidden" name="action" value="firmadoc-generar">
      <input type="hidden" name="modo_multifirma" id="input-modo-multifirma" value="unico">

      {# Descripción del modo seleccionado #}
      <div id="desc-modo-unico" class="alert alert-light py-1 mb-2" style="display:block">
        <i class="fas fa-user text-primary me-1"></i>
        {{ trans('firmadoc-tab-mode-single-desc')|raw }}
      </div>
      <div id="desc-modo-paralelo" class="alert alert-light py-1 mb-2" style="display:none">
        <i class="fas fa-users text-success me-1"></i>
        {{ trans('firmadoc-tab-mode-parallel-desc')|raw }}
      </div>
      <div id="desc-modo-secuencial" class="alert alert-light py-1 mb-2" style="display:none">
        <i class="fas fa-list-ol text-warning me-1"></i>
        {{ trans('firmadoc-tab-mode-sequential-desc')|raw }}
      </div>

      {# Contenedor de firmantes #}
      <div id="firmantes-container">
        {# Firmante 1 — siempre visible, datos del cliente #}
        <div class="firmante-row border rounded p-2 mb-2" id="firmante-row-1">
          <div class="row g-2 align-items-end">
            <div class="col-auto d-none" id="col-orden-1">
              <span class="badge bg-secondary">1</span>
            </div>
            <div class="col-md-3">
              <label class="mb-0">{{ trans('name') }} <span class="text-danger">*</span></label>
              <input type="text" name="firmantes[0][nombre]" class="form-control"
                     value="{{ view.firmadocNombre }}" placeholder="{{ trans('firmadoc-signer-name') }}" required>
            </div>
            <div class="col-md-3">
              <label class="mb-0">{{ trans('email') }} <span class="text-danger">*</span></label>
              <input type="email" name="firmantes[0][email]" class="form-control"
                     value="{{ emailPrellenado }}" placeholder="{{ trans('email') }}" required>
            </div>
            <div class="col-md-2">
              <label class="mb-0">WhatsApp</label>
              <input type="text" name="firmantes[0][telefono]" class="form-control"
                     value="{{ telefonoPrellenado }}" placeholder="+34 600 000 000">
            </div>
            <div class="col-md-2">
              <label class="mb-0">{{ trans('reference') }}</label>
              <input type="text" name="firmantes[0][nombre_referencia]" class="form-control"
                     placeholder="{{ trans('reference') }}">
            </div>
            <div class="col-md-1 d-none" id="col-eliminar-1">
              <button type="button" class="btn btn-outline-danger w-100"
                      onclick="firmadocEliminarFirmante(1)">
                <i class="fas fa-times"></i>
              </button>
            </div>
          </div>
        </div>
      </div>

      {# Botón añadir firmante — oculto en modo unico #}
      <div id="btn-anadir-container" style="display:none" class="mb-2">
        <button type="button" class="btn btn-outline-success" onclick="firmadocAnadirFirmante()">
          <i class="fas fa-plus me-1"></i> {{ trans('firmadoc-add-signer') }}
        </button>
        <small class="text-muted ms-2">{{ trans('firmadoc-tab-max-signers', {'%count%': 5}) }}</small>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-2">
        <small class="text-muted">
          {% if view.firmadocEditable %}
            {{ trans('firmadoc-tab-links-valid-days', {'%days%': config.dias_validez}) }}
          {% endif %}
        </small>
        <button type="submit" class="btn btn-primary" {% if not view.firmadocEditable %}disabled{% endif %}>
          <i class="fas fa-paper-plane me-1"></i> {{ trans('firmadoc-tab-send-links') }}
        </button>
      </div>

      {% if not view.firmadocEditable %}
      <div class="alert alert-info py-2 mt-2 mb-0">
        <i class="fas fa-lock me-1"></i> {{ trans('firmadoc-tab-not-editable') }}
      </div>
      {% endif %}
    </form>
  </div>
</div>
{% endif %}

<script>
// Los textos que enseña el JavaScript salen de las traducciones, igual que los del HTML
var FD_CONFIRMAR_CANCELAR  = {{ trans('firmadoc-tab-confirm-cancel') | json_encode | raw }};
var FD_EMAILS_DUPLICADOS   = {{ trans('firmadoc-tab-dup-emails') | json_encode | raw }};
var FD_TELEFONOS_DUPLICADOS = {{ trans('firmadoc-tab-dup-phones') | json_encode | raw }};
var FD_ENLACE_COPIADO      = {{ trans('firmadoc-tab-link-copied') | json_encode | raw }};

var _firmadocNumFirmantes = 1;
var _firmadocModo = 'unico';

function firmadocSetModo(modo) {
  _firmadocModo = modo;
  document.getElementById('input-modo-multifirma').value = modo;

  // Botones modo
  ['unico','paralelo','secuencial'].forEach(function(m) {
    document.getElementById('btn-modo-' + m).classList.toggle('active', m === modo);
    document.getElementById('desc-modo-' + m).style.display = (m === modo) ? 'block' : 'none';
  });

  // Mostrar/ocultar botón añadir
  var esMulti = (modo !== 'unico');
  document.getElementById('btn-anadir-container').style.display = esMulti ? 'block' : 'none';

  // Mostrar/ocultar numeración ordinal
  for (var i = 1; i <= _firmadocNumFirmantes; i++) {
    var colOrden = document.getElementById('col-orden-' + i);
    if (colOrden) colOrden.classList.toggle('d-none', modo !== 'secuencial');
    var colElim = document.getElementById('col-eliminar-' + i);
    if (colElim) colElim.classList.toggle('d-none', !esMulti || i === 1);
  }

  // Si volvemos a individual, eliminar filas extra
  if (modo === 'unico' && _firmadocNumFirmantes > 1) {
    for (var j = _firmadocNumFirmantes; j >= 2; j--) {
      firmadocEliminarFirmante(j);
    }
  }
}

function firmadocAnadirFirmante() {
  if (_firmadocNumFirmantes >= 5) return;
  _firmadocNumFirmantes++;
  var idx = _firmadocNumFirmantes - 1;
  var n   = _firmadocNumFirmantes;
  var seq = (_firmadocModo === 'secuencial');

  var html = '<div class="firmante-row border rounded p-2 mb-2" id="firmante-row-' + n + '">'
    + '<div class="row g-2 align-items-end">'
    + '<div class="col-auto ' + (seq ? '' : 'd-none') + '" id="col-orden-' + n + '">'
    + '<span class="badge bg-secondary">' + n + '</span></div>'
    + '<div class="col-md-3"><label class="mb-0">{{ trans('name') }} <span class=\"text-danger\">*</span></label>'
    + '<input type="text" name="firmantes[' + idx + '][nombre]" class="form-control" placeholder="{{ trans('firmadoc-signer-name') }}" required></div>'
    + '<div class="col-md-3"><label class="mb-0">{{ trans('email') }} <span class=\"text-danger\">*</span></label>'
    + '<input type="email" name="firmantes[' + idx + '][email]" class="form-control" placeholder="{{ trans('email') }}" required></div>'
    + '<div class="col-md-2"><label class="mb-0">WhatsApp</label>'
    + '<input type="text" name="firmantes[' + idx + '][telefono]" class="form-control" placeholder="+34 600 000 000"></div>'
    + '<div class="col-md-2"><label class="mb-0">{{ trans('reference') }}</label>'
    + '<input type="text" name="firmantes[' + idx + '][nombre_referencia]" class="form-control" placeholder="{{ trans('reference') }}"></div>'
    + '<div class="col-md-1" id="col-eliminar-' + n + '">'
    + '<button type="button" class="btn btn-outline-danger w-100" onclick="firmadocEliminarFirmante(' + n + ')">'
    + '<i class="fas fa-times"></i></button></div>'
    + '</div></div>';

  document.getElementById('firmantes-container').insertAdjacentHTML('beforeend', html);
}


function firmadocEliminarFirmante(n) {
  var row = document.getElementById('firmante-row-' + n);
  if (row) row.remove();
  _firmadocNumFirmantes--;
}

// Validar duplicados de email y teléfono antes de enviar.
// El formulario solo está en la página cuando no hay una firma en curso: en la
// pestaña de un documento ya firmado no existe, y darlo por hecho rompía el resto
// del script de la pestaña.
var _firmadocForm = document.getElementById('form-firmadoc-generar');
if (_firmadocForm) {
  _firmadocForm.addEventListener('submit', function(e) {
    var emails    = [];
    var telefonos = [];
    var hasDupEmail = false;
    var hasDupTel   = false;

    this.querySelectorAll('input[type="email"]').forEach(function(el) {
      var v = el.value.trim().toLowerCase();
      if (!v) return;
      if (emails.indexOf(v) !== -1) { hasDupEmail = true; }
      emails.push(v);
    });
    this.querySelectorAll('input[type="text"][name*="telefono"]').forEach(function(el) {
      var v = el.value.trim().replace(/[\s\-]/g, '');
      if (!v) return;
      if (telefonos.indexOf(v) !== -1) { hasDupTel = true; }
      telefonos.push(v);
    });

    if (hasDupEmail) {
      e.preventDefault();
      alert(FD_EMAILS_DUPLICADOS);
      return false;
    }
    if (hasDupTel) {
      e.preventDefault();
      alert(FD_TELEFONOS_DUPLICADOS);
      return false;
    }
  });
}
</script>

{# ── HISTORIAL ─── #}
{% if firmas|length > 0 %}
<div class="card shadow mb-3">
  <div class="container-fluid pt-3">
    <h3 class="h4 mb-2"><i class="fas fa-history fa-fw me-2"></i>{{ trans('firmadoc-resend-history') }}</h3>
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>{{ trans('status') }}</th>
          <th>{{ trans('firmadoc-tab-generated') }}</th>
          <th>{{ trans('email') }}</th>
          <th>{{ trans('firmadoc-field-signer') }}</th>
          <th>{{ trans('firmadoc-sign-date') }}</th>
          <th>IP</th>
          <th title="{{ trans('firmadoc-tab-times-viewed') }}">{{ trans('firmadoc-tab-views') }}</th>
          <th>{{ trans('notes') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for firma in firmas %}
        {# Fila principal de la solicitud #}
        <tr class="{% if firma.estado == 'firmado' %}table-success{% elseif firma.estado == 'pendiente' %}table-warning{% elseif firma.estado in ['cancelado','expirado','anulado_mod'] %}table-light{% endif %}">
          <td>
            {% if firma.estado == 'firmado' %}
              <span class="badge bg-success"><i class="fas fa-check me-1"></i>{{ trans('firmadoc-badge-signed') }}</span>
            {% elseif firma.estado == 'pendiente' %}
              <span class="badge bg-primary"><i class="fas fa-clock me-1"></i>{{ trans('firmadoc-badge-pending') }}</span>
            {% elseif firma.estado == 'anulado_mod' %}
              <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle me-1"></i>{{ trans('firmadoc-tab-badge-voided') }}</span>
            {% elseif firma.estado == 'cancelado' %}
              <span class="badge bg-danger"><i class="fas fa-times me-1"></i>{{ trans('firmadoc-tab-badge-cancelled') }}</span>
            {% elseif firma.estado == 'expirado' %}
              <span class="badge bg-secondary"><i class="fas fa-hourglass-end me-1"></i>{{ trans('firmadoc-tab-badge-expired') }}</span>
            {% else %}
              <span class="badge bg-secondary">{{ firma.estado }}</span>
            {% endif %}
            {# Indicador modo multi-firmante #}
            {% if firma.modo_multifirma and firma.modo_multifirma != 'unico' %}
              <br><small class="text-muted">
                {% if firma.modo_multifirma == 'paralelo' %}
                  <i class="fas fa-users me-1"></i>{{ trans('firmadoc-mode-parallel') }}
                {% elseif firma.modo_multifirma == 'secuencial' %}
                  <i class="fas fa-list-ol me-1"></i>{{ trans('firmadoc-mode-sequential') }}
                {% endif %}
              </small>
            {% endif %}
          </td>
          <td>{{ firma.fecha_envio }}</td>
          <td>{{ firma.email_cliente }}</td>
          <td>
            {% if firma.firma_nombre %}
              <strong>{{ firma.firma_nombre }}</strong>
              {% if firma.firma_nif %}<br>{{ firma.firma_nif }}{% endif %}
            {% else %}
              —
            {% endif %}
            {% if firma.estado == 'firmado' and firma.firma_imagen and (firma.modo_multifirma == 'unico' or not firma.modo_multifirma) %}
            <br>
            <button type="button" class="btn btn-sm btn-outline-success mt-1"
                    onclick="firmadocVerFirma('{{ firma.id }}')"
                    title="{{ trans('firmadoc-tab-view-signature-image') }}">
              <i class="fas fa-signature me-1"></i>{{ trans('firmadoc-tab-view-signature') }}
            </button>
            {% endif %}
          </td>
          <td>{% if firma.fecha_firma %}{{ firma.fecha_firma }}{% else %}—{% endif %}</td>
          <td>{{ firma.ip_cliente ?? '—' }}</td>
          <td>
            {% if firma.veces_visto > 0 %}
              <span title="{{ trans('firmadoc-tab-first-opened', {'%date%': firma.fecha_primera_apertura}) }}">
                <i class="fas fa-eye text-muted me-1"></i>{{ firma.veces_visto }}x
              </span>
            {% else %}
              <span class="text-muted">{{ trans('firmadoc-tab-not-viewed') }}</span>
            {% endif %}
          </td>
          <td>
            {% if firma.observaciones_firmante %}
              <span class="text-info" title="{{ firma.observaciones_firmante }}">
                <i class="fas fa-comment-alt me-1"></i>{{ trans('yes') }}
              </span>
            {% elseif firma.motivo_rechazo %}
              <span class="text-danger" title="{{ firma.motivo_rechazo }}">
                <i class="fas fa-times-circle me-1"></i>{{ trans('firmadoc-tab-rejected') }}
              </span>
            {% else %}—{% endif %}
          </td>
        </tr>
        {# Sub-filas de firmantes individuales si hay multi-firmante #}
        {% if firma.firmantes is defined and firma.firmantes|length > 1 %}
          {% for firmante in firma.firmantes %}
          <tr class="table-light">
            <td class="ps-4">
              <span class="text-muted me-1">&#8627;</span>
              {% if firmante.estado == 'firmado' %}
                <span class="badge bg-success">{{ trans('firmadoc-badge-signed') }}</span>
              {% elseif firmante.estado == 'esperando' %}
                <span class="badge bg-secondary">{{ trans('firmadoc-tab-waiting') }}</span>
              {% else %}
                <span class="badge bg-warning text-dark">{{ trans('firmadoc-badge-pending') }}</span>
              {% endif %}
            </td>
            <td colspan="2">
              <i class="fas fa-envelope me-1 text-muted"></i>{{ firmante.email }}
              {% if firmante.nombre_referencia %}
                <span class="text-muted ms-2">({{ firmante.nombre_referencia }})</span>
              {% endif %}
            </td>
            <td>
              {% if firmante.firma_nombre %}
                <strong>{{ firmante.firma_nombre }}</strong>
              {% else %}—{% endif %}
              {% if firmante.estado == 'firmado' and firmante.firma_imagen %}
              <br>
              <button type="button" class="btn btn-sm btn-outline-success mt-1"
                      onclick="firmadocVerFirmaFirmante('{{ firmante.id }}')"
                      title="{{ trans('firmadoc-tab-view-signature-image-of', {'%name%': firmante.nombre}) }}">
                <i class="fas fa-signature me-1"></i>{{ trans('firmadoc-tab-view') }}
              </button>
              {% endif %}
            </td>
            <td>{% if firmante.fecha_firma %}{{ firmante.fecha_firma }}{% else %}—{% endif %}</td>
            <td>{% if firmante.ip_cliente %}{{ firmante.ip_cliente }}{% else %}—{% endif %}</td>
            <td>
              {% if firmante.veces_visto > 0 %}
                <span title="{{ trans('firmadoc-tab-first-opened', {'%date%': firmante.fecha_primera_apertura ?? ''}) }}">
                  <i class="fas fa-eye text-muted me-1"></i>{{ firmante.veces_visto }}x
                </span>
              {% else %}
                <span class="text-muted">{{ trans('firmadoc-tab-not-viewed') }}</span>
              {% endif %}
            </td>
            <td></td>
          </tr>
          {% endfor %}
        {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endif %}

{# ── HISTORIAL DE REENVÍOS ─── #}
{% if view.firmadocReenvios is defined and view.firmadocReenvios|length > 0 %}
<div class="card shadow mb-3">
  <div class="container-fluid pt-3">
    <h3 class="h4 mb-2">
      <i class="fas fa-paper-plane fa-fw me-2"></i>{{ trans('firmadoc-tab-email-history') }}
      <span class="badge bg-secondary">{{ view.firmadocReenvios|length }}</span>
    </h3>
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>{{ trans('date') }}</th>
          <th>{{ trans('type') }}</th>
          <th>{{ trans('firmadoc-tab-recipient') }}</th>
          <th>{{ trans('firmadoc-tab-sent-by') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for r in view.firmadocReenvios %}
        <tr>
          <td>{{ r.fecha }}</td>
          <td>
            {% if r.tipo == 'inicial' %}
              <span class="badge bg-dark">{{ trans('firmadoc-tab-initial') }}</span>
            {% elseif r.tipo == 'reenvio' %}
              <span class="badge bg-info">{{ trans('firmadoc-tab-resend') }}</span>
            {% else %}
              <span class="badge bg-primary">{{ trans('firmadoc-mode-sequential') }}</span>
            {% endif %}
          </td>
          <td>
            {% if r.nombre_destino %}<strong>{{ r.nombre_destino }}</strong><br>{% endif %}
            {{ r.email_destino }}
          </td>
          <td>{{ r.nick ?: trans('firmadoc-tab-system') }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endif %}

</div>


{# ── MODALES DE FIRMA ─── #}
{# Modal principal para firmas de solicitud (modo único o cabecera) #}
{% for firma in firmas %}
{% if firma.estado == 'firmado' and firma.firma_imagen %}
<div class="modal" id="modalFirma{{ firma.id }}" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fas fa-signature fa-fw me-1"></i>{{ trans('firmadoc-tab-signature-of') }} <strong>{{ firma.firma_nombre }}</strong>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center bg-light">
        <img src="{{ firma.firma_imagen }}" alt="{{ trans('firmadoc-tab-signature') }}" class="img-fluid border rounded bg-white p-2"
             style="max-height:220px">
        <div class="mt-2 small text-muted">
          {% if firma.firma_nif %}<span class="me-3"><i class="fas fa-id-card"></i>&nbsp;{{ firma.firma_nif }}</span>{% endif %}
          {% if firma.fecha_firma %}<span class="me-3"><i class="fas fa-calendar-check"></i>&nbsp;{{ firma.fecha_firma }}</span>{% endif %}
          {% if firma.ip_cliente %}<span><i class="fas fa-map-marker-alt"></i>&nbsp;{{ firma.ip_cliente }}</span>{% endif %}
        </div>
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ trans('close') }}</button>
      </div>
    </div>
  </div>
</div>
{% endif %}
{# Modales para firmantes individuales (multi-firmante) #}
{% if firma.firmantes is defined %}
{% for firmante in firma.firmantes %}
{% if firmante.estado == 'firmado' and firmante.firma_imagen %}
<div class="modal" id="modalFirmaFirmante{{ firmante.id }}" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fas fa-signature fa-fw me-1"></i>{{ trans('firmadoc-tab-signature-of') }} <strong>{{ firmante.firma_nombre ?: firmante.nombre }}</strong>
          {% if firmante.nombre_referencia %}<small class="text-muted ms-2">({{ firmante.nombre_referencia }})</small>{% endif %}
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center bg-light">
        <img src="{{ firmante.firma_imagen }}" alt="{{ trans('firmadoc-tab-signature') }}" class="img-fluid border rounded bg-white p-2"
             style="max-height:220px">
        <div class="mt-2 small text-muted">
          {% if firmante.firma_nif %}<span class="me-3"><i class="fas fa-id-card"></i>&nbsp;{{ firmante.firma_nif }}</span>{% endif %}
          {% if firmante.fecha_firma %}<span class="me-3"><i class="fas fa-calendar-check"></i>&nbsp;{{ firmante.fecha_firma }}</span>{% endif %}
          {% if firmante.ip_cliente %}<span><i class="fas fa-map-marker-alt"></i>&nbsp;{{ firmante.ip_cliente }}</span>{% endif %}
        </div>
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ trans('close') }}</button>
      </div>
    </div>
  </div>
</div>
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}

<script>
function firmadocVerFirma(id) {
    var el = document.getElementById('modalFirma' + id);
    if (el) { new bootstrap.Modal(el).show(); }
}
function firmadocVerFirmaFirmante(id) {
    var el = document.getElementById('modalFirmaFirmante' + id);
    if (el) { new bootstrap.Modal(el).show(); }
}
function firmadocCopiar() {
    var el = document.getElementById('firmadocLinkInput');
    if (el) {
        navigator.clipboard.writeText(el.value).then(function() {
            alert(FD_ENLACE_COPIADO);
        }).catch(function() {
            el.select();
            document.execCommand('copy');
            alert(FD_ENLACE_COPIADO);
        });
    }
}
</script>
