<view>
    <columns>
        <group name="document" numcolumns="12" icon="fas fa-file-alt">
            <column name="firmadoc-doc-type" order="100">
                <widget type="text" fieldname="tipo_doc" readonly="true"/>
            </column>
            <column name="firmadoc-verify-document" order="110">
                <widget type="text" fieldname="titulo"/>
            </column>
            <column name="code" order="120">
                <widget type="text" fieldname="codigo_doc" readonly="true"/>
            </column>
            <column name="status" order="130">
                <widget type="text" fieldname="estado" readonly="true">
                    <option color="warning" font="bold">pendiente</option>
                    <option color="success" font="bold">firmado</option>
                    <option color="secondary">expirado</option>
                    <option color="danger">cancelado</option>
                    <option color="dark">anulado_mod</option>
                </widget>
            </column>
        </group>
        <group name="firmadoc-recipient" numcolumns="12" icon="fas fa-user">
            <column name="customer" order="100">
                <widget type="autocomplete" fieldname="codcliente" onclick="EditCliente">
                    <values source="clientes" fieldcode="codcliente" fieldtitle="nombre"/>
                </widget>
            </column>
            <column name="supplier" order="110">
                <widget type="autocomplete" fieldname="codproveedor" onclick="EditProveedor">
                    <values source="proveedores" fieldcode="codproveedor" fieldtitle="nombre"/>
                </widget>
            </column>
            <column name="email" order="120">
                <widget type="text" fieldname="email_cliente"/>
            </column>
            <column name="phone" order="130">
                <widget type="text" fieldname="telefono_cliente"/>
            </column>
        </group>
        <group name="firmadoc-dates" numcolumns="12" icon="fas fa-calendar">
            <column name="firmadoc-send-sent" order="100">
                <widget type="datetime" fieldname="fecha_envio" readonly="true"/>
            </column>
            <column name="firmadoc-send-expires" order="110">
                <widget type="datetime" fieldname="fecha_expiracion"/>
            </column>
            <column name="firmadoc-sign-date" order="120">
                <widget type="datetime" fieldname="fecha_firma" readonly="true"/>
            </column>
            <column name="user" order="130">
                <widget type="text" fieldname="nick" readonly="true"/>
            </column>
        </group>
        <group name="firmadoc-signature-data" numcolumns="12" icon="fas fa-signature">
            <column name="firmadoc-pdf-full-name" order="100">
                <widget type="text" fieldname="firma_nombre" readonly="true"/>
            </column>
            <column name="firmadoc-field-nif" order="110">
                <widget type="text" fieldname="firma_nif" readonly="true"/>
            </column>
            <column name="firmadoc-pdf-mode" order="120">
                <widget type="text" fieldname="modo_firma" readonly="true"/>
            </column>
            <column name="firmadoc-pdf-signer-ip" order="130">
                <widget type="text" fieldname="ip_cliente" readonly="true"/>
            </column>
        </group>
        <group name="firmadoc-evidence" numcolumns="12" icon="fas fa-shield-alt">
            <column name="firmadoc-verification-code" order="100">
                <widget type="text" fieldname="codigo_verificacion" readonly="true"/>
            </column>
            <column name="firmadoc-pdf-timestamp-date" order="110">
                <widget type="datetime" fieldname="sello_fecha" readonly="true"/>
            </column>
            <column name="firmadoc-pdf-second-factor" order="120">
                <widget type="checkbox" fieldname="otp_verificado" readonly="true"/>
            </column>
            <column name="firmadoc-pdf-times-seen" order="130">
                <widget type="number" fieldname="veces_visto" readonly="true"/>
            </column>
            <column name="firmadoc-verify-hash" numcolumns="12" order="140">
                <widget type="text" fieldname="doc_hash" readonly="true"/>
            </column>
        </group>
        <group name="firmadoc-observations" numcolumns="12" icon="fas fa-comment-alt">
            <column name="firmadoc-pdf-signer-notes" numcolumns="12" order="100">
                <widget type="textarea" fieldname="observaciones_firmante" readonly="true"/>
            </column>
            <column name="firmadoc-field-reason" numcolumns="12" order="110">
                <widget type="textarea" fieldname="motivo_rechazo" readonly="true"/>
            </column>
        </group>
    </columns>
    <rows>
        <!-- La fila tiene que existir para que el controlador pueda añadirle botones:
             addButton() no crea la fila, solo escribe en ella si ya está. Los botones
             se añaden desde loadData() según el estado del registro. -->
        <row type="actions"/>
    </rows>
</view>
