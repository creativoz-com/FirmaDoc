<view>
    <columns>
        <column name="date" display="left" order="100">
            <widget type="datetime" fieldname="fecha_envio" onclick="EditFirmaDoc" fieldclick="id"/>
        </column>
        <column name="firmadoc-doc-type" display="left" order="110">
            <widget type="text" fieldname="tipo_doc"/>
        </column>
        <column name="firmadoc-verify-document" display="left" order="120">
            <widget type="text" fieldname="titulo" onclick="EditFirmaDoc" fieldclick="id"/>
        </column>
        <column name="code" display="left" order="130">
            <widget type="text" fieldname="codigo_doc" onclick="EditFirmaDoc" fieldclick="id"/>
        </column>
        <column name="customer" display="left" order="140">
            <widget type="autocomplete" fieldname="codcliente" onclick="EditCliente">
                <values source="clientes" fieldcode="codcliente" fieldtitle="nombre"/>
            </widget>
        </column>
        <column name="email" display="left" order="150">
            <widget type="text" fieldname="email_cliente"/>
        </column>
        <column name="firmadoc-send-expires" display="center" order="160">
            <widget type="datetime" fieldname="fecha_expiracion"/>
        </column>
        <column name="status" display="center" order="170">
            <widget type="text" fieldname="estado">
                <option color="warning" font="bold">pendiente</option>
                <option color="success" font="bold">firmado</option>
                <option color="secondary">expirado</option>
                <option color="danger">cancelado</option>
                <option color="dark">anulado_mod</option>
            </widget>
        </column>
        <column name="firmadoc-sign-date" display="center" order="180">
            <widget type="datetime" fieldname="fecha_firma"/>
        </column>
    </columns>
</view>
