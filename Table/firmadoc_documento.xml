<table>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
    </column>
    <column>
        <name>id_firmadoc</name>
        <type>integer</type>
        <null>NO</null>
    </column>
    <column>
        <name>idfile</name>
        <type>integer</type>
        <null>NO</null>
    </column>
    <column>
        <name>orden</name>
        <type>integer</type>
        <null>NO</null>
        <default>1</default>
    </column>
    <column>
        <name>tipo</name>
        <type>character varying(10)</type>
        <null>NO</null>
        <default>'firmar'</default>
    </column>
    <column>
        <name>nombre</name>
        <type>character varying(200)</type>
        <null>YES</null>
    </column>
    <column>
        <name>doc_hash</name>
        <type>character varying(64)</type>
        <null>YES</null>
    </column>
    <constraint>
        <name>firmadoc_documento_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>firmadoc_documento_firmadoc_fkey</name>
        <type>FOREIGN KEY (id_firmadoc) REFERENCES firmadoc (id) ON DELETE CASCADE</type>
    </constraint>
</table>
